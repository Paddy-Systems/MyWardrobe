<?xml version="1.0" encoding="utf-8"?>
<data-extraction-rules>
    <cloud-backup>
        <!--
            Cloud Auto Backup is not appropriate for photo-heavy wardrobes.
            The in-app .mwbackup flow is the portable backup source of truth.
        -->
        <exclude domain="file" path="profiles/" />
        <exclude domain="file" path="profiles.json" />
        <exclude domain="file" path="models/" />
    </cloud-backup>

    <device-transfer>
        <!-- Models are bundled with the APK and can be recreated after transfer. -->
        <exclude domain="file" path="models/" />
    </device-transfer>
</data-extraction-rules>
