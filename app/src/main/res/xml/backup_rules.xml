<?xml version="1.0" encoding="utf-8"?>
<full-backup-content>
    <!--
        Large wardrobe data is intentionally excluded from Android Auto Backup.
        Use Wearfolio's versioned .wearfolio export for reliable portable backups.
    -->
    <exclude domain="file" path="profiles/" />
    <exclude domain="file" path="profiles.json" />
    <exclude domain="file" path="models/" />
</full-backup-content>
