<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="Theme.Wearfolio" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:navigationBarColor">@color/wearfolio_ivory</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.Wearfolio.Starting" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/wearfolio_ivory</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/wearfolio_splash_icon</item>
        <item name="postSplashScreenTheme">@style/Theme.Wearfolio</item>
    </style>
</resources>
